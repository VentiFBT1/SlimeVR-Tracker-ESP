diff --git a/src/espnow/receiveQueue.h b/src/espnow/receiveQueue.h
new file mode 100644
--- /dev/null
+++ b/src/espnow/receiveQueue.h
@@ -0,0 +1,51 @@
+#pragma once
+
+#include <esp_now.h>
+#include <freertos/FreeRTOS.h>
+#include <freertos/queue.h>
+#include <atomic>
+#include <cstdint>
+#include <cstring>
+
+// The Wi-Fi task only copies into this bounded queue. Radio replies, flash,
+// tracker lists, and USB report buffers belong exclusively to the main loop.
+class ESPNowReceiveQueue {
+public:
+    struct Frame {
+        uint8_t mac[6];
+        int8_t rssi;
+        uint8_t length;
+        uint8_t data[ESP_NOW_MAX_DATA_LEN];
+    };
+    static constexpr size_t Capacity = 32;
+
+    bool begin() {
+        if (!queue) queue = xQueueCreateStatic(Capacity, sizeof(Frame), storage, &control);
+        return queue != nullptr;
+    }
+    bool push(const esp_now_recv_info_t* info, const uint8_t* data, int length) {
+        if (!queue || !info || !info->src_addr || !info->rx_ctrl || !data ||
+            length < 1 || length > ESP_NOW_MAX_DATA_LEN) return false;
+        Frame frame{};
+        memcpy(frame.mac, info->src_addr, sizeof(frame.mac));
+        frame.rssi = info->rx_ctrl->rssi;
+        frame.length = static_cast<uint8_t>(length);
+        memcpy(frame.data, data, length);
+        // A full queue drops a frame; it must never block the Wi-Fi task.
+        if (xQueueSend(queue, &frame, 0) != pdTRUE) {
+            dropped.fetch_add(1, std::memory_order_relaxed);
+            return false;
+        }
+        return true;
+    }
+    bool pop(Frame& frame) {
+        return queue && xQueueReceive(queue, &frame, 0) == pdTRUE;
+    }
+    uint32_t droppedFrames() const { return dropped.load(std::memory_order_relaxed); }
+
+private:
+    StaticQueue_t control{};
+    uint8_t storage[Capacity * sizeof(Frame)]{};
+    QueueHandle_t queue = nullptr;
+    std::atomic<uint32_t> dropped{0};
+};
